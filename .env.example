# Template of the environment variables the harness reads for API backends.
# Copy to `.env` and fill in real keys. `.env` is gitignored; this template is committed.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

